<Window x:Class="Brand_25.Selection_FloorFinish"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Floor Finish" Height="640" Width="560" MinHeight="480" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="LightGray" WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bdr_main" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Content"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr_main" Property="Background" Value="#a7a7a7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr_main" Property="Background" Value="#979797"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CustomButtonFontStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Regular"/>
        </Style>
        <Style x:Key="CustomFontStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="FontWeight" Value="Regular"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#272727"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="4 2 4 2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#272727"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" MouseLeftButtonDown="Window_MouseLeftButtonDown" Background="#474747">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="35"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Image x:Name="icon" Width="25" Height="25" Margin="5 0 0 0"/>
                <TextBlock Foreground="White" Name="TitleText" Text="Create Floor Finish" FontSize="16" VerticalAlignment="Center" Margin="10 0 0 0"
                           Style="{StaticResource CustomFontStyle}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1" Background="#474747">
                <Button Style="{StaticResource TitleBarButtonStyle}" x:Name="buttonClose" Width="35" Background="Transparent" BorderBrush="Transparent"
                        Click="buttonClose_Click">
                    <Image x:Name="closeImage" Width="20" Height="20"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="15 10 15 10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- level / option context -->
                <RowDefinition Height="Auto"/>  <!-- room selection -->
                <RowDefinition Height="Auto"/>  <!-- floor type label + filter -->
                <RowDefinition Height="*"/>     <!-- floor type list (scrolls) -->
                <RowDefinition Height="Auto"/>  <!-- offset -->
                <RowDefinition Height="Auto"/>  <!-- skip existing -->
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding ContextText}" Style="{StaticResource LabelStyle}"
                       TextWrapping="Wrap" Margin="0 0 0 10"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 15">
                <Button Content="Select Rooms" Width="130" Height="30" Click="SelectRooms_Click"
                        Style="{StaticResource CustomButtonFontStyle}"/>
                <TextBlock Text="{Binding RoomSummary}" Style="{StaticResource LabelStyle}" Margin="12 0 0 0"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0 0 0 5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Floor Type:" Style="{StaticResource LabelStyle}" Margin="0 0 10 0"/>
                <TextBox Grid.Column="1" x:Name="FilterBox" Style="{StaticResource InputBoxStyle}"
                         TextChanged="FilterBox_TextChanged" ToolTip="Type to filter floor types by name"/>
            </Grid>

            <ListBox Grid.Row="3" x:Name="FloorTypeListBox" SelectionMode="Single" Background="White"
                     FontFamily="Calibri" FontSize="16" Margin="0 0 0 15"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ItemsSource="{Binding FloorTypes}"
                     SelectedItem="{Binding SelectedFloorType, Mode=TwoWay}"
                     DisplayMemberPath="DisplayLabel"/>

            <Grid Grid.Row="4" Margin="0 0 0 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Raise top of finish above level (mm):" Style="{StaticResource LabelStyle}"/>
                <TextBox Grid.Column="1" Style="{StaticResource InputBoxStyle}" HorizontalContentAlignment="Right"
                         Text="{Binding OffsetText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <CheckBox Grid.Row="5" Style="{StaticResource CheckBoxStyle}"
                      Content="Skip rooms that already have a finish (matched by Comments)"
                      IsChecked="{Binding SkipExisting, Mode=TwoWay}"/>
        </Grid>

        <!-- Footer -->
        <Button Content="Create" Width="80" Height="30" Click="Create_Click"
                Style="{StaticResource CustomButtonFontStyle}"
                HorizontalAlignment="Left" Grid.Row="2" VerticalAlignment="Top"
                Margin="15 0 0 10"/>

        <StackPanel Orientation="Vertical" HorizontalAlignment="Right" Grid.Row="2" Margin="0 0 10 10">
            <Image x:Name="brandLogo" Width="150" Height="50"
                   VerticalAlignment="Top" HorizontalAlignment="Right"
                   Margin="0 0 0 0"/>
            <TextBlock x:Name="FooterText" Style="{StaticResource CustomFontStyle}" FontSize="12" Foreground="white"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"/>
        </StackPanel>
    </Grid>
</Window>
