<Window x:Class="Brand_25.Selection_PlanAlign"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Brand_25"
        Title="Align Plans on Sheets" Height="700" Width="700" WindowStartupLocation="CenterScreen"
        Background="LightGray" WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>

        <Style x:Key="TitleBarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bdr_main" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Content"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr_main" Property="Background" Value="#a7a7a7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr_main" Property="Background" Value="#979797"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomButtonFontStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Regular"/>
        </Style>

        <Style x:Key="CustomFontStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="FontWeight" Value="Regular"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CustomFontStyle}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#272727"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0 0 0 4"/>
        </Style>

        <Style x:Key="CustomComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="28"/>
        </Style>

        <!-- Sheet header row in the target tree — not selectable, bold, matches the
             app's dark accent so it reads clearly as a grouping row, not a plan item. -->
        <Style x:Key="TreeSheetHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource CustomFontStyle}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#474747"/>
            <Setter Property="Margin" Value="0 4 0 2"/>
        </Style>

        <Style x:Key="TreePlanCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#272727"/>
            <Setter Property="Margin" Value="0 2 0 2"/>
        </Style>

        <!-- Implicit style — expands every TreeViewItem (sheet header rows) by default,
             so the user sees every plan without having to manually expand each sheet. -->
        <Style TargetType="{x:Type TreeViewItem}">
            <Setter Property="IsExpanded" Value="True"/>
        </Style>

        <HierarchicalDataTemplate x:Key="PlanSheetGroupTemplate" ItemsSource="{Binding Plans}">
            <TextBlock Text="{Binding HeaderText}" Style="{StaticResource TreeSheetHeaderStyle}"/>
            <HierarchicalDataTemplate.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding DisplayLabel}"
                              Style="{StaticResource TreePlanCheckBoxStyle}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding IsSourceExcluded, Converter={StaticResource InverseBoolConverter}}"/>
                </DataTemplate>
            </HierarchicalDataTemplate.ItemTemplate>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0" MouseLeftButtonDown="Window_MouseLeftButtonDown" Background="#474747">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="105"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Image x:Name="icon" Width="25" Height="25" Margin="5 0 0 0"/>
                <TextBlock Foreground="White" Name="TitleText" FontSize="16" VerticalAlignment="Center" Margin="10 0 0 0"
                           Style="{StaticResource CustomFontStyle}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1" Background="#474747">
                <Button Style="{StaticResource TitleBarButtonStyle}" x:Name="buttonMinimize" Width="35"
                        Background="Transparent" BorderBrush="Transparent" Click="buttonMinimize_Click">
                    <Image x:Name="minimizeImage" Width="20" Height="20"/>
                </Button>
                <Button Style="{StaticResource TitleBarButtonStyle}" x:Name="buttonMaximize" Width="35"
                        Background="Transparent" BorderBrush="Transparent" Click="buttonMaximize_Click">
                    <Image x:Name="maximizeImage" Width="20" Height="20"/>
                </Button>
                <Button Style="{StaticResource TitleBarButtonStyle}" x:Name="buttonClose" Width="35"
                        Background="Transparent" BorderBrush="Transparent" Click="buttonClose_Click">
                    <Image x:Name="closeImage" Width="20" Height="20"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Source plan -->
        <StackPanel Grid.Row="1" Margin="15 12 15 4">
            <TextBlock Text="Align plans to the setting-out of:" Style="{StaticResource LabelStyle}"/>
            <ComboBox x:Name="SourceCombo" Style="{StaticResource CustomComboBoxStyle}"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Select the plan(s) to align — grouped by sheet:"
                   Style="{StaticResource LabelStyle}" Margin="15 10 15 4"/>

        <!-- Target tree -->
        <TreeView x:Name="TargetTree" Grid.Row="3" Margin="15 0 15 10" Background="#D8D8D8"
                  ItemTemplate="{StaticResource PlanSheetGroupTemplate}"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15 0 0 10">
            <Button Style="{StaticResource CustomButtonFontStyle}" Content="Align Selected" Width="140" Margin="0 0 10 0" Click="OK_Click"/>
            <Button Style="{StaticResource CustomButtonFontStyle}" Content="Select All" Width="100" Margin="0 0 10 0" Click="SelectAll_Click"/>
            <Button Style="{StaticResource CustomButtonFontStyle}" Content="Select None" Width="100" Margin="0 0 10 0" Click="SelectNone_Click"/>
            <Button Style="{StaticResource CustomButtonFontStyle}" Content="Cancel" Width="80" Click="Cancel_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Vertical" HorizontalAlignment="Right" Margin="0 0 10 10">
            <Image x:Name="brandLogo" Width="150" Height="50" VerticalAlignment="Top" HorizontalAlignment="Right"/>
            <TextBlock x:Name="FooterText" Style="{StaticResource CustomFontStyle}" FontSize="12" Foreground="White"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        </StackPanel>
    </Grid>
</Window>
