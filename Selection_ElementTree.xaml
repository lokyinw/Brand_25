<Window x:Class="Brand_25.Selection_ElementTree"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Brand_25"
        Title="Select Elements (Live)"
        Height="700" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="LightGray"
        WindowStyle="None"
        ShowInTaskbar="True">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Styles -->
        <Style x:Key="TitleBarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bdr_main" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Content"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr_main" Property="Background" Value="#a7a7a7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr_main" Property="Background" Value="#979797"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomButtonFontStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Regular"/>
        </Style>

        <Style x:Key="CustomFontStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="FontWeight" Value="Regular"/>
        </Style>

        <!-- Instance-count suffix ("Doors [196]") — shown at every level EXCEPT
             Instance, where "[1]" next to every single leaf would just be noise. -->
        <Style x:Key="InstanceCountStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#707070"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Instance">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Tree row: checkbox + label + instance count. IsThreeState="False" at
             EVERY level (not just Instance) is what blocks the user from ever
             clicking a box into the indeterminate state — WPF's own toggle logic
             guarantees a click always lands on a definite true/false when
             IsThreeState is False, even starting from an indeterminate value. The
             indeterminate glyph itself still renders correctly whenever the bound
             VALUE is null (i.e. derived from mixed children) — that rendering is
             driven by the value, not by IsThreeState, so nothing is lost here
             except the ability to click INTO that state.
             Note: checking this box does NOT zoom the view — zoom is tied to
             highlighting a row (TreeView's own row-selection), handled via
             TreeView.SelectedItemChanged below, entirely separate from IsChecked. -->
        <HierarchicalDataTemplate DataType="{x:Type local:VM_ElementTreeNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0 2 0 2">
                <CheckBox IsThreeState="False"
                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="0 0 6 0"/>
                <TextBlock Text="{Binding Name}" Style="{StaticResource CustomFontStyle}"
                           FontSize="14" Foreground="#272727" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding InstanceCount, StringFormat=' [{0}]'}"
                           Style="{StaticResource InstanceCountStyle}"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- Drives expand/collapse from VM_ElementTreeNode.IsExpanded, which the
             window seeds from a persisted path->expanded map on every rebuild
             (see Selection_ElementTree.CreateNode) so a manually expanded branch
             survives a live rebuild instead of resetting to collapsed. Also
             drives per-row Visibility from RowVisibility (search filtering), and
             turns on recycling virtualization at every level of the hierarchy —
             with every model category now in scope (not just Doors), the tree
             can get considerably larger than before. -->
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Visibility" Value="{Binding RowVisibility}"/>
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0" MouseLeftButtonDown="Window_MouseLeftButtonDown" Background="#474747">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="105"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Image x:Name="icon" Width="25" Height="25" Margin="5 0 0 0"/>
                <TextBlock Foreground="White" Name="TitleText" FontSize="16" VerticalAlignment="Center" Margin="10 0 0 0"
                           Style="{StaticResource CustomFontStyle}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1" Background="#474747">
                <Button Style="{StaticResource TitleBarButtonStyle}" x:Name="buttonMinimize" Width="35"
                        Background="Transparent" BorderBrush="Transparent" Click="buttonMinimize_Click">
                    <Image x:Name="minimizeImage" Width="20" Height="20"/>
                </Button>
                <Button Style="{StaticResource TitleBarButtonStyle}" x:Name="buttonMaximize" Width="35"
                        Background="Transparent" BorderBrush="Transparent" Click="buttonMaximize_Click">
                    <Image x:Name="maximizeImage" Width="20" Height="20"/>
                </Button>
                <Button Style="{StaticResource TitleBarButtonStyle}" x:Name="buttonClose" Width="35"
                        Background="Transparent" BorderBrush="Transparent" Click="buttonClose_Click">
                    <Image x:Name="closeImage" Width="20" Height="20"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Scope selector -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10 8 10 4">
            <TextBlock Text="Show:" Style="{StaticResource CustomFontStyle}" FontSize="14"
                       Foreground="#272727" VerticalAlignment="Center" Margin="0 0 8 0"/>
            <ComboBox x:Name="ScopeCombo" Width="220" FontFamily="Calibri" FontSize="14"
                      SelectionChanged="ScopeCombo_SelectionChanged">
                <ComboBoxItem Content="Entire Project" Tag="{x:Static local:ElementTreeScope.EntireProject}"/>
                <ComboBoxItem Content="Active View" Tag="{x:Static local:ElementTreeScope.ActiveView}"/>
                <ComboBoxItem Content="Current Selection" Tag="{x:Static local:ElementTreeScope.CurrentSelection}"/>
            </ComboBox>
        </StackPanel>

        <!-- Search — narrows the tree to Instance rows matching Mark, Family
             name, Type name, Id, or Keynote (case-insensitive), plus their
             ancestor path so a match is actually reachable. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10 0 10 4">
            <TextBlock Text="Search:" Style="{StaticResource CustomFontStyle}" FontSize="14"
                       Foreground="#272727" VerticalAlignment="Center" Margin="0 0 8 0"/>
            <TextBox x:Name="SearchBox" Width="300" FontFamily="Calibri" FontSize="14"
                     TextChanged="SearchBox_TextChanged"/>
            <!-- Clears the search text. Doesn't need to touch scope or checked
                 state at all — search only ever hides/shows already-built rows,
                 it never re-queries Revit or alters _checkedIds, so clearing it
                 naturally reveals everything the current "Show:" scope already
                 produced, with every checkbox exactly as the user left it. -->
            <Button x:Name="ClearSearchButton" Content="✕" Width="26" Height="24" Margin="4 0 0 0"
                    FontFamily="Calibri" FontSize="13" ToolTip="Clear search"
                    Click="ClearSearch_Click"/>
        </StackPanel>

        <!-- Tree. SelectedItemChanged drives the zoom-to-element behavior — fires
             on a plain row click/highlight (TreeView's own row selection), fully
             independent of the checkbox. VirtualizingStackPanel here + on the
             TreeViewItem style above together give recycling virtualization
             through the whole hierarchy. -->
        <TreeView x:Name="ElementTreeView" Grid.Row="3" Background="LightGray" BorderThickness="0" Margin="10 4 10 10"
                  SelectedItemChanged="ElementTreeView_SelectedItemChanged"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"/>

        <!-- Buttons — no OK/Cancel: every checkbox change already applies live to
             Revit's selection, so there's nothing left to "commit" at the end. -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10 0 0 10">
            <Button Style="{StaticResource CustomButtonFontStyle}" Content="Close" Width="80" Margin="0 0 10 0" Click="buttonClose_Click"/>
            <Button Style="{StaticResource CustomButtonFontStyle}" Content="Select All" Width="100" Margin="0 0 10 0" Click="SelectAll_Click"/>
            <Button Style="{StaticResource CustomButtonFontStyle}" Content="Select None" Width="100" Margin="0 0 10 0" Click="SelectNone_Click"/>
            <Button Style="{StaticResource CustomButtonFontStyle}" Content="Collapse All" Width="110" Click="CollapseAll_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Vertical" HorizontalAlignment="Right" Margin="0 0 10 10">
            <Image x:Name="brandLogo" Width="150" Height="50" VerticalAlignment="Top" HorizontalAlignment="Right"/>
            <TextBlock x:Name="FooterText" Style="{StaticResource CustomFontStyle}" FontSize="12" Foreground="White"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        </StackPanel>
    </Grid>
</Window>
